# Generate secrets, never reuse these names as literal values:
#   openssl rand -base64 48
JWT_SECRET=
CRON_SECRET=

# The reference Compose deployment binds to localhost and enables the requested
# private single-user admin auto-login. Disable it before exposing the site
# without an authenticated reverse proxy/VPN.
ADMIN_AUTOLOGIN_ENABLED=true
ADMIN_USERNAME=Administrator
ADMIN_EMAIL=admin@localhost
ALLOW_SELF_REGISTRATION=false
AUTH_SESSION_SECONDS=28800

CTS_BIND_ADDRESS=127.0.0.1
CTS_PORT=3001
CTS_TRUSTED_ORIGINS=localhost:3001
CTS_DEPLOYMENT_ID=compose-production
REDIS_SNAPSHOT_INTERVAL_MS=30000

# Exchange credentials stay server-side. Use a key restricted to trading,
# without withdrawal permission, and an IP allowlist whenever available.
BINGX_API_KEY=
BINGX_API_SECRET=
