# Dependencies and build output
node_modules/
.next/
out/
dist/
build/
.vercel/
.turbo/

# Secrets: only the documented empty template is versioned
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Runtime state and operator data
.v0-data/*
!.v0-data/.gitkeep
data/connections.json
data/settings.json
backups/
*.snapshot.json
*.sqlite
*.sqlite3

# Logs, caches and editor files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.nx/
coverage/
__pycache__/
.DS_Store
*.local

# Alternate lockfiles are not authoritative
bun.lock
pnpm-lock.yaml
yarn.lock

# Imported historical reports and captured runtime responses are retained only
# in the working source material, not in the production release.
/*.md
!/README.md
!/SECURITY.md
!/PRODUCTION_VALIDATION.md
/docs/
/backup/
/poll*.json
/quickstart-output.json
/COMPREHENSIVE_TEST_SUITE.sh
